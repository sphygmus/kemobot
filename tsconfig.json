{
	"compilerOptions": {
		"target": "es2016",
		"lib": [
			"es6"
		],
		"module": "commonjs",
		"rootDir": "src",
		"resolveJsonModule": true,
		"allowJs": true,
		"outDir": "build",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true
	},
	"ts-node": {
		"files": true,
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules"
	]
}